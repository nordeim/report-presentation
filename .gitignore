#  which silently excluded the DB layer from every commit: audit C1)
/db/
dev.log
tool-results/
server.log
server.pid
tsconfig.tsbuildinfo

# user uploads & deliverables (kept local, never published)
upload/
download/

# local reference clone (read-only design reference, not part of this codebase)
blessed-sacrament-church/

# research & scraping artifacts
scripts/imgsearch/
scripts/shots/
scripts/oll*.json
scripts/oll*.html

# OS / editor noise
.DS_Store
*.local

# skills/ is INTENTIONALLY tracked (skills/skills-catalog.md is part of the
# repo's agent tooling contract) — do not add it to .gitignore.
