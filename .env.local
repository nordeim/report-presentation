# Database — must match docker-compose.yml (nave_spire_dev) unless you run a different Postgres.
# Format: postgresql://[user[:password]@][host[:port]][/database][?options]
# Recommended local (docker compose up -d postgres):
DATABASE_URL="postgresql://nave_spire_user:nave_spire_secret@127.0.0.1:5432/nave_spire_dev"
# Alternative plain postgres (if you run postgres:postgres@app_db):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"
# Production (managed Postgres, add sslmode):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
